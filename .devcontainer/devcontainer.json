{
  "name": "C++ Tips",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "mounts": [
    "source=cpptips-devcontainer-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "bun install --frozen-lockfile",
  "containerEnv": {
    "SITE_URL": "https://cpp.tips"
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro development server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
